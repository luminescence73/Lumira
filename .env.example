DISCORD_TOKEN=
# Required by npm run register. npm start discovers the application from the token.
DISCORD_CLIENT_ID=
# Set for guild-only slash command registration. Leave blank for global registration.
DISCORD_GUILD_ID=
# Optional comma-separated allowlist for direct chat. Empty allows direct chat in eligible channels.
LUMIRA_CHANNEL_IDS=
LUMIRA_SPONTANEOUS_ENABLED=false
# Optional comma-separated spontaneous-chat channels. Empty uses public channels.
LUMIRA_SPONTANEOUS_CHANNEL_IDS=
# Enable in the Discord Developer Portal before setting this to true.
LUMIRA_MEMBERS_INTENT=false
# Railway production uses a persistent volume mounted at /data.
LUMIRA_DATA_DIR=./data
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_MODEL=
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=
LUMIRA_IMAGE_DAILY_LIMIT=2
